        "from google.colab import files\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import io\n",
        "\n",
        "# Upload the fuel efficiency dataset\n",
        "uploaded = files.upload()\n",
        "df = pd.read_csv(io.BytesIO(next(iter(uploaded.values()))))\n",
        "\n",
        "print(\"Dataset:\")\n",
        "print(df.head())\n",
        "\n",
        "# Select the highway fuel efficiency column\n",
        "fuel_efficiency = pd.to_numeric(\n",
        "    df[\"highway_mpg(Fuel Efficiency)\"],\n",
        "    errors=\"coerce\"\n",
        ").dropna().to_numpy()\n",
        "\n",
        "# Calculate average fuel efficiency\n",
        "average = np.mean(fuel_efficiency)\n",
        "\n",
        "print(\"\\nAverage fuel efficiency:\",\n",
        "      round(average, 2), \"MPG\")\n",
        "\n",
        "# Compare the first and last car records\n",
        "model1 = fuel_efficiency[0]\n",
        "model2 = fuel_efficiency[-1]\n",
        "\n",
        "if model1 != 0:\n",
        "    improvement = ((model2 - model1) / model1) * 100\n",
        "    print(\"First car efficiency:\", model1, \"MPG\")\n",
        "    print(\"Last car efficiency:\", model2, \"MPG\")\n",
        "    print(\"Percentage improvement:\",\n",
        "          round(improvement, 2), \"%\")\n",
        "else:\n",
        "    print(\"Cannot calculate percentage because the first value is zero.\")"
      ],
