      "source": [
        "from google.colab import files\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import io\n",
        "\n",
        "# Upload the CSV dataset\n",
        "uploaded = files.upload()\n",
        "df = pd.read_csv(io.BytesIO(next(iter(uploaded.values()))))\n",
        "\n",
        "print(\"Dataset:\")\n",
        "print(df)\n",
        "\n",
        "# Select only subject columns\n",
        "subjects = [\"Math\", \"Science\", \"English\", \"History\"]\n",
        "student_scores = df[subjects].to_numpy(dtype=float)\n",
        "\n",
        "# Calculate average marks\n",
        "averages = np.mean(student_scores, axis=0)\n",
        "\n",
        "print(\"\\nAverage marks:\")\n",
        "for subject, avg in zip(subjects, averages):\n",
        "    print(subject, \":\", round(avg, 2))\n",
        "\n",
        "# Find subject(s) with highest average\n",
        "highest = np.max(averages)\n",
        "print(\"\\nHighest average:\", highest)\n",
        "print(\"Subject(s) with highest average:\",\n",
        "      [subjects[i] for i in np.where(averages == highest)[0]])"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from google.colab import files\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import io\n",
        "\n",
        "uploaded = files.upload()\n",
        "df = pd.read_csv(io.BytesIO(next(iter(uploaded.values()))))\n",
        "\n",
        "print(\"Dataset:\")\n",
        "print(df)\n",
        "\n",
        "sales = df.select_dtypes(include=np.number).to_numpy()\n",
        "print(\"\\nAverage price:\", round(np.mean(sales), 2))"
      ],
