      "cell_type": "code",
      "source": [
        "from google.colab import files\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import io\n",
        "\n",
        "# Upload the CSV dataset\n",
        "uploaded = files.upload()\n",
        "df = pd.read_csv(io.BytesIO(next(iter(uploaded.values()))))\n",
        "\n",
        "print(\"Dataset:\")\n",
        "print(df.head())\n",
        "\n",
        "# Convert sales amount to numeric\n",
        "df[\"Total\"] = pd.to_numeric(df[\"Total\"], errors=\"coerce\")\n",
        "\n",
        "# Extract month from Month_sales\n",
        "df[\"Month_sales\"] = pd.to_datetime(\n",
        "    df[\"Month_sales\"], format=\"%B %Y\", errors=\"coerce\"\n",
        ")\n",
        "\n",
        "# Calculate total sales for each month\n",
        "monthly_sales = df.groupby(\n",
        "    df[\"Month_sales\"].dt.month\n",
        ")[\"Total\"].sum()\n",
        "\n",
        "print(\"\\nMonthly sales:\")\n",
        "print(monthly_sales)\n",
        "\n",
        "# Calculate total annual sales\n",
        "total_sales = np.sum(df[\"Total\"].dropna())\n",
        "print(\"\\nTotal annual sales:\", round(total_sales, 2))\n",
        "\n",
        "# Calculate percentage increase from January to December\n",
        "if 1 in monthly_sales.index and 12 in monthly_sales.index:\n",
        "    jan_sales = monthly_sales.loc[1]\n",
        "    dec_sales = monthly_sales.loc[12]\n",
        "\n",
        "    if jan_sales != 0:\n",
        "        percentage = ((dec_sales - jan_sales) / jan_sales) * 100\n",
        "        print(\"Percentage change from January to December:\",\n",
        "              round(percentage, 2), \"%\")\n",
        "    else:\n",
        "        print(\"Cannot calculate percentage: January sales are zero.\")\n",
        "else:\n",
        "    print(\"January or December sales data is missing.\")"
      ],
